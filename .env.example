# Defaults work with SQLite JDBC fallback. Copy to .env only to override them.
APP_PORT=8080
APP_HOST=127.0.0.1
# Optional if Java is installed but not on PATH:
# JAVA_HOME=C:\path\to\jdk-17
DB_MODE=JDBC_FALLBACK
DB_URL=jdbc:sqlite:../database/videos.db
DB_DRIVER=org.sqlite.JDBC
DB_USER=
DB_PASSWORD=
DB_DSN=

# Public cloud deployment: a PostgreSQL database such as Neon.
# Keep DB_USER and DB_PASSWORD in host environment variables, not in Git.
# DB_MODE=POSTGRES
# DB_DRIVER=org.postgresql.Driver
# DB_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
# DB_USER=YOUR_NEON_USER
# DB_PASSWORD=YOUR_NEON_PASSWORD
# APP_HOST=0.0.0.0
# COOKIE_SECURE=true
# APP_DEMO_ADMIN_ENABLED=false

# Free Oracle XE through Oracle JDBC, using the local SQL*Plus database:
# DB_MODE=ORACLE
# DB_DRIVER=oracle.jdbc.OracleDriver
# DB_URL=jdbc:oracle:thin:@//127.0.0.1:1522/XE
# DB_USER=VMS_APP
# DB_PASSWORD=the_password_in_your_private_env_file

# CData JDBC-ODBC Bridge example on Windows after its licensed JAR is installed:
# DB_MODE=ODBC
# DB_DRIVER=cdata.jdbc.jdbcodbc.JDBCODBCDriver
# DB_URL=jdbc:cdata:jdbcodbc:Driver={Microsoft Access Driver (*.mdb, *.accdb)};DBQ=C:\absolute\path\to\database\videos-odbc.accdb
# DB_DSN= is blank for this DSN-less connection.

